# supercronic crontab — renewal checks twice daily (02:00 and 14:00 container-local)
# renew-all issues/renews a certificate once a third of its lifetime remains
# (RENEW_WINDOW_DAYS overrides), then deploys + activates on every target.
# --source cron marks the runs as scheduled in history and in scheduler.json,
# which /healthz uses to detect a scheduler that stopped running.
# Output goes to supercronic (docker compose logs) and is appended to renew.log.
0 2  * * * cd /app && bash -o pipefail -c 'python -m app.cli renew-all --source cron 2>&1 | tee -a /data/logs/renew.log'
0 14 * * * cd /app && bash -o pipefail -c 'python -m app.cli renew-all --source cron 2>&1 | tee -a /data/logs/renew.log'
