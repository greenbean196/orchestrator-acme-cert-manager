# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
# Keep values unquoted. If edited on Windows, strip CRs: sed -i 's/\r$//' .env

# --- Where the server list lives inside the container (persistent bind mount) ---
SERVERS_FILE=/config/servers.json

# --- Cloudflare DNS-01 (Lego reads this name) ---
# Fallback used when a server has no inline token set in the web UI.
CF_DNS_API_TOKEN=your-cloudflare-api-token

# --- Orchestrator REST API key (OrchestratorAdmin, Read/Write) ---
# Fallback used when a server has no inline key set in the web UI.
ORCH_API_KEY=your-orchestrator-api-key

# --- Service user (written by ./setup.sh to your own uid/gid) ---
# The cert manager container runs unprivileged as this uid/gid, which must own
# ./config, ./data/certs and ./data/logs and be able to read ./data/ssh.
#OACM_UID=1000
#OACM_GID=1000

# --- Renewal window (optional) ---
# Unset: renew once a third of the certificate's own lifetime remains (30 days
# for a 90-day certificate, 15 for 45, 2 for 6). Set a number of days to
# override with an absolute window.
#RENEW_WINDOW_DAYS=30

# --- Container timezone (affects cron + logs) ---
TZ=America/New_York

# --- Failure alerting (optional) ---
# Incoming-webhook URL (Slack/Discord/Teams/generic). Leave blank to disable.
NOTIFY_WEBHOOK_URL=
# "failed" (default) alerts only on failures; "all" also announces renewals.
NOTIFY_ON=failed

# --- Startup strictness ---
# "true" (default): refuse to start when the config path is not persistently
# mounted or only a legacy /data/servers.json exists. "false" logs a warning.
STRICT_STARTUP=true

# --- Bundled lab CA (optional; written by ./setup.sh --with-ca) ---
# COMPOSE_PROFILES=lab-ca enables the step-ca service. LAB_CA_HOST must be a
# name under LAB_CA_DOMAIN with a DNS record (Cloudflare, DNS-only) pointing at
# this host's private address; the CA's own certificate is issued under the
# same name constraints as everything else. LAB_CA_PORT is the port step-ca
# listens on inside and outside the container. These values are pinned at init
# (data/pki/config/lab-ca.meta); setup.sh refuses to change them in place.
#COMPOSE_PROFILES=lab-ca
#LAB_CA_DOMAIN=lab.example.net
#LAB_CA_HOST=ca.lab.example.net
#LAB_CA_PORT=9000
#LAB_CA_UID=1000
#LAB_CA_GID=1000
